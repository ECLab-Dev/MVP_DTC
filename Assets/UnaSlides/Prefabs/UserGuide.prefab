  m_FontData:
    m_Font: {fileID: 12800000, guid: 1f87eb43215d5409c884289cd053014b, type: 3}
    m_FontSize: 11
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 1
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 0.8
  m_Text: "\u3010User's Guide\u3011\n\n\u25CF Making Slides\r\n- Make \"1 slide /
    1 sec\" video and upload it to Youtube.\r Set duration(sec) if you want to change
    duration per each slide.\n- PowerPoint: Export as PDF and convert it to MP4.\n-
    PDF: Use UnaSlides Web Converter -> https://unagiken.com/unaslides/\r\n- Google
    Slides: Export as PDF and use the converter above.\r\n- You can include video
    to play in your slides.\r\n\r\n\u25CF Control Slides\r\n- Pickup the Slide Controller
    first on your turn to get privilege to control UnaSlides.\r\n- Enter url of your
    slides.\r\n- [ > ] Go to next. Same as tapping right side of the screen by raycast.\n-
    [ < ] Back to previous. Same as tapping right side of the screen by raycast.\n-
    [ >> ] Play / Pause the video.\r\n- [ Reload ] Reload slides.\n- [ Unload ] End
    presentation.\r\n- [ SP/DS ] Toggle modes. SP: Only speaker can control next/back.
    All: Everyone can control next/back.\r Lock: No one can control.\n- [ \u21A9
    ] Back to the first slide.\n- [ Status ] Check the number who has completed loading
    slides / number of the person in the world.\n\n\u25CF For Quest users\r\n- Use
    video that Quest users can play.\n\n\u25CF Trouble shooting\r\n- Speaker: Press
    [ Unload ] to end the slide show and input URL again to restart.\r\n- Audience:
    Press [ Reload ] button under the main screen to reload the slides show if you
    can find it in the world. Or, exit and re-enter here again.\r\n"
